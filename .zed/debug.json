{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: mhost (desktop)",
      "type": "go",
      "request": "launch",
      "program": "${ZED_WORKTREE_ROOT}/cmd/mhost",
      "cwd": "${ZED_WORKTREE_ROOT}",
      "args": [],
      "env": {},
      "stopOnEntry": false
    },
    {
      "name": "Debug: mhost-dns-proxy",
      "type": "go",
      "request": "launch",
      "program": "${ZED_WORKTREE_ROOT}/cmd/mhost-dns-proxy",
      "cwd": "${ZED_WORKTREE_ROOT}",
      "args": ["-listen", "127.0.0.1:15353", "-target", "127.0.0.1:11053"],
      "env": {},
      "stopOnEntry": false
    },
    {
      "name": "Debug: hosts-fixture (10w lines)",
      "type": "go",
      "request": "launch",
      "program": "${ZED_WORKTREE_ROOT}/cmd/hosts-fixture",
      "cwd": "${ZED_WORKTREE_ROOT}",
      "args": ["-output", "build/local/hosts-100k.txt", "-lines", "100000"],
      "env": {},
      "stopOnEntry": false
    }
  ]
}
